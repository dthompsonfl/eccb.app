# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit these.
#
# A root .env containing live AUTH_SECRET, BETTER_AUTH_SECRET, SETUP_TOKEN,
# SUPER_ADMIN_PASSWORD and ENCRYPTION_KEY values was committed in 34667e6 while
# this rule was commented out. It has been untracked; the values must be
# treated as compromised and rotated (see docs/SECURITY.md).
#
# `.env.example` / `env.example` are the only env files that may be committed.
.env
.env.*
*.env
!.env.example
!env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploaded files
/public/uploads/*
!/public/uploads/.gitkeep
*/smart-upload/*
*./smart-upload

# e2e tests
/test-results/
/playwright-report/
/playwright/.cache/
e2e/.auth/
e2e/screenshots/
e2e-results.json
*.webm

# local artifacts & caches
/dev.db
/prisma/dev.db
/logs/
/outbox/
/storage/

# Python sidecar (services/glm-ocr) build/cache artifacts
__pycache__/
*.py[cod]
.venv/
