    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.13",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.624",
    "prisma": "^7.10.0",
    "react": "19.2.3",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "react-resizable-panels": "^4.5.7",
    "recharts": "^3.7.0",
    "redis": "^5.10.0",
