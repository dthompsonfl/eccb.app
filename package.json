{
  "name": "eccb-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "postinstall": "npm run sync:pdf-worker && prisma generate",
    "predev": "npm run sync:pdf-worker",
    "dev": "next dev",
    "dev:workers": "tsx src/workers/index.ts",
    "dev:full": "concurrently -n \"next,workers\" -c \"cyan,magenta\" \"next dev\" \"tsx src/workers/index.ts\"",
    "dev:port": "next dev --port ${PORT:-3225}",
    "prebuild": "npm run sync:pdf-worker",
    "build": "next build && npm run prepare:standalone",
    "build:production": "npm run db:generate && next build && npm run prepare:standalone",
    "prepare:standalone": "tsx scripts/prepare-standalone.ts",
    "start:server": "next start",
    "prestart": "npm run sync:pdf-worker",
    "prestart:all": "npm run sync:pdf-worker",
    "start:workers": "tsx src/workers/index.ts",
    "lint": "eslint",
    "test": "npm run permissions:audit && tsx scripts/assert-no-skipped-tests.ts && vitest",
    "test:run": "npm run permissions:audit && tsx scripts/assert-no-skipped-tests.ts && vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:smart-upload:fixtures": "tsx scripts/test-smart-upload-fixtures.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ci": "playwright test --reporter=html,json,line",
    "test:e2e:setup": "playwright test e2e/auth.setup.ts --project=setup",
    "test:all": "npm run test:run && npm run test:e2e:ci",
    "verify:preview": "tsx scripts/verify-upload-review-preview.ts",
    "check-routes": "tsx scripts/check-routes.ts",
    "sync:pdf-worker": "node scripts/sync-pdf-worker.mjs",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:seed:production": "prisma db seed",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "security:audit": "bash scripts/security-audit.sh",
    "security:check": "npm audit --audit-level=moderate",
    "security:fix": "npm audit --fix",
    "deps:check": "tsx scripts/dependency-check.ts",
    "deps:update": "npm outdated && npm update",
    "start:sockets": "tsx src/server/socket-worker.ts",
    "setup": "tsx scripts/verify-env.ts && npm run db:generate",
    "start": "next start",
    "start:all": "tsx scripts/start.ts",
    "typecheck": "tsc --noEmit",
    "validate": "npm run security:scan-secrets && npm run lint && npm run typecheck && npm run test:run && npm run build",
    "validate:ci": "npm run security:scan-secrets && npm run lint && npm run typecheck && npm run test:run && npm run build && npm run test:e2e:ci",
    "permissions:audit": "tsx scripts/assert-canonical-permissions.ts",
    "security:scan-secrets": "tsx scripts/scan-secrets.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.893.0",
