[Unit]
Description=ECCB Platform — web (Next.js)
Documentation=file:///var/www/eccb/DEPLOYMENT.md
After=network-online.target mariadb.service redis-server.service
Wants=network-online.target
Requires=mariadb.service redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/eccb

# Secrets live in a root-owned, 0600 file — never in the unit or in git.
EnvironmentFile=/etc/eccb/eccb.env

# `scripts/serve.ts` hosts Next AND the Stand Socket.IO server on ONE port.
#
# It must NOT be `next start`, for one reason: `next start` binds only Next.
# The Stand Socket.IO server must be attached to the SAME http.Server and port
# as Next, because a WebSocket upgrade can never be proxied by a
# `next.config.ts` rewrite — the browser receives a 308 it cannot follow and
# silently drops to polling, while every health endpoint still reports realtime
# healthy. serve.ts does that attachment; `next start` cannot.
#
# Note: `next start` does still serve static assets correctly under
# `output: 'standalone'` (verified: hashed /_next/static chunks return 200).
# Next prints a "does not work with output: standalone" warning, but the asset
# serving works — the blocker is the missing socket, not styling.
#
# Running serve.ts under tsx keeps a single supervised PID (no `npx` wrapper
# process to orphan on restart), which matters because Restart=always below.
#
# serve.ts reads PORT/BIND_HOST from /etc/eccb/eccb.env.
#
# This process is stateless: all durable state lives in MariaDB and Redis, so
# it can be restarted freely.
ExecStart=/usr/bin/node --import tsx /var/www/eccb/scripts/serve.ts

Restart=always
RestartSec=10

# Give in-flight requests a chance to finish before SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=30

# Hardening: the web process needs no shell and no new privileges, and should
# only be able to write to the upload/log directories.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/www/eccb/storage /var/www/eccb/logs

StandardOutput=journal
StandardError=journal
SyslogIdentifier=eccb-web

[Install]
WantedBy=multi-user.target
