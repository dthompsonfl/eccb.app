# =============================================================================
# ECCB Platform — production environment file template
# =============================================================================
#
# Install as /etc/eccb/eccb.env with mode 0600, owned by root:
#   sudo install -o root -g root -m 600 eccb.env.example /etc/eccb/eccb.env
#
# Then fill in real values. NEVER commit a filled-in copy of this file.
#
#   !! ROTATION REQUIRED BEFORE FIRST PRODUCTION DEPLOY !!
#   The repository history (commit 34667e6, still present on origin/main)
#   contains real values for AUTH_SECRET, BETTER_AUTH_SECRET, SETUP_TOKEN,
#   SUPER_ADMIN_PASSWORD and ENCRYPTION_KEY. Those values must be treated as
#   COMPROMISED and rotated. Do not copy any of them from git history into
#   this file. Generate fresh values as shown below.
#
# Generate a secret:
#   openssl rand -base64 32
#
# Rotating AUTH_SECRET or BETTER_AUTH_SECRET invalidates all active sessions
# (users log back in). That is the desired effect after an exposure.
# =============================================================================

NODE_ENV=production

# ─── Application ─────────────────────────────────────────────────────────────
PORT=3000
NEXT_PUBLIC_APP_URL=https://eccb.example.org
NEXT_PUBLIC_APP_NAME=Emerald Coast Community Band

# ─── Database (MySQL / MariaDB) ──────────────────────────────────────────────
# Use a dedicated least-privilege user, NOT root.
DATABASE_URL=mysql://eccb:REPLACE_ME@127.0.0.1:3306/eccb_production

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ─── Authentication ─────────────────────────────────────────────────────────
# Both must be >= 32 chars. Generate fresh — do not reuse a historical value.
# BETTER_AUTH_SECRET signs sessions and derives the at-rest encryption key, so
# rotating it also invalidates any data encrypted with the old key.
AUTH_SECRET=REPLACE_WITH_openssl_rand_base64_32
BETTER_AUTH_SECRET=REPLACE_WITH_openssl_rand_base64_32

# The first administrator. The password here is used only to bootstrap; it
# should be changed after the first login.
SUPER_ADMIN_EMAIL=admin@eccb.example.org
SUPER_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD

# ─── Setup control plane ────────────────────────────────────────────────────
# Keep SETUP_MODE=false in production. The setup/repair endpoints run
# migrations and can reset the database, so they must be explicitly unlocked
# with a token and locked again immediately after use. Never leave
# SETUP_MODE=true on a live system.
SETUP_MODE=false
SETUP_TOKEN=REPLACE_WITH_openssl_rand_base64_32

# ─── Optional: Google OAuth ──────────────────────────────────────────────────
# Leave empty to disable. If enabled, both values are required.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Storage ────────────────────────────────────────────────────────────────
# LOCAL for single-node. Use s3 for multi-node or when music must survive a
# host rebuild. Both are supported; do not mix paths across the cluster.
STORAGE_DRIVER=LOCAL
LOCAL_STORAGE_PATH=/var/www/eccb/storage
MAX_FILE_SIZE=104857600

# S3 (only when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_BUCKET_NAME=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ─── Email (SMTP) ───────────────────────────────────────────────────────────
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Emerald Coast Community Band <no-reply@eccb.example.org>"

# ─── Push notifications (Web Push / VAPID) ──────────────────────────────────
# Generate a pair with: npx web-push generate-vapid-keys
# VAPID_PRIVATE_KEY is secret and must never be logged or exposed to the client.
# Push is not yet wired end-to-end; see README.md "Not implemented".
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─── Logging / retention ────────────────────────────────────────────────────
LOG_DIR=/var/www/eccb/logs
LOG_RETENTION_DAYS=30
LOG_MAX_SIZE_MB=50
LOG_ROTATION=daily

# ─── Processes ──────────────────────────────────────────────────────────────
# Leave both true for a normal production deployment. Both default to true when
# unset, so omitting them is safe.
#
# ENABLE_WORKER=false yields a WEB-ONLY instance: no email, no scheduler, no
# cleanup, and Smart Upload sessions that queue forever. That is only correct when
# another host runs `npm run start:workers`. The failure is silent — every health
# endpoint still reports healthy — so `start:all` emits a preflight WARNING.
ENABLE_WORKER=true

# The dedicated OCR fallback queue. Smart Upload OCRs inline regardless; this
# worker exists only for the operator-triggered re-run at
# POST /api/admin/uploads/review/[id]/reocr, which is its sole producer.
# Set to false to release a BullMQ consumer and Redis connection when that
# endpoint is unused. The endpoint then returns an error rather than queueing a
# job nothing consumes.
ENABLE_OCR_WORKER=true

# Stand live-sync. When false the Stand polls (stand.pollingIntervalMs) and the
# eccb-sockets systemd unit should NOT be started.
ENABLE_WEBSOCKETS=false
SOCKET_PORT=3005

WORKER_HEALTH_PORT=3001
PROCESS_MANAGER_HEALTH_PORT=3002
RESTART_CRASHED_PROCESSES=true

# ─── Scheduler / maintenance ────────────────────────────────────────────────
# All times are UTC; the scheduler converts per-event.
SCHEDULER_INTERVAL_MS=60000
CLEANUP_INTERVAL_MS=3600000

# ─── Smart Upload ───────────────────────────────────────────────────────────
SMART_UPLOAD_ENABLED=true
SMART_UPLOAD_MAX_TOTAL_BYTES=209715200
# tesseract | ocrmypdf | native | pdf_text
SMART_UPLOAD_OCR_MODE=native

# ─── LLM provider for Smart Upload ──────────────────────────────────────────
# openai | anthropic | gemini | glm-ocr | ollama | custom
LLM_PROVIDER=openai
LLM_ENDPOINT_URL=
LLM_VISION_MODEL=
LLM_VERIFICATION_MODEL=
LLM_OPENAI_API_KEY=
LLM_ANTHROPIC_API_KEY=
LLM_GEMINI_API_KEY=
LLM_OPENROUTER_API_KEY=
LLM_CUSTOM_API_KEY=

# ─── OCR provider (optional) ────────────────────────────────────────────────
OMR_PROVIDER=none

# ─── Feature flags ──────────────────────────────────────────────────────────
FEATURE_MUSIC_STAND=true
FEATURE_PRACTICE_TRACKING=true
FEATURE_STAND_WEBSOCKET_SYNC=false
# NOT IMPLEMENTED — reserved only. See README.md. Do not rely on these.
FEATURE_STAND_OFFLINE=false
FEATURE_STAND_AUDIO_SYNC=false

# ─── Maintenance / rate limiting ────────────────────────────────────────────
# true = fail closed when Redis is unavailable (safer, stricter).
# false = fail open (avoids lockouts, weaker abuse protection).
RATE_LIMIT_FAIL_OPEN=false
