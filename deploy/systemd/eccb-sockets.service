[Unit]
Description=ECCB Platform — Stand live-sync WebSocket server (LEGACY — do not enable)
Documentation=file:///var/www/eccb/DEPLOYMENT.md
After=network-online.target eccb-web.service mariadb.service redis-server.service
Wants=network-online.target
Requires=redis-server.service

# ============================================================================
# DO NOT ENABLE THIS UNIT.
# ============================================================================
#
# It is retained only so an existing host that still has it enabled can be
# migrated deliberately rather than silently.
#
# This process binds SOCKET_PORT on its own HTTP server. Nothing can reach it:
# `next.config.ts` deliberately defines NO rewrite for /api/stand/socket,
# because a WebSocket upgrade is never proxied by a rewrite (the browser gets a
# 308 it cannot follow and silently drops to polling). So this server accepts
# connections that no member will ever make, while burning a process and a port.
#
# `scripts/serve.ts` — what eccb-web.service runs — attaches the Stand socket to
# the SAME http.Server and port as Next, so there is no cross-port hop and no
# redirect to follow. That is the supported topology.
#
# Migration:
#   sudo systemctl disable --now eccb-sockets
#   sudo rm /etc/systemd/system/eccb-sockets.service
#   sudo systemctl daemon-reload
#
# Then confirm realtime still works:
#   curl -fsS localhost:3000/api/health | grep -A4 '"sockets"'
# ============================================================================

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/eccb

EnvironmentFile=/etc/eccb/eccb.env

ExecStart=/usr/bin/node /var/www/eccb/node_modules/.bin/tsx src/server/socket-worker.ts

Restart=always
RestartSec=10

# Socket.io holds long-lived connections. Give them time to close cleanly on
# deploy instead of severing them mid-annotation-sync.
KillSignal=SIGTERM
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/www/eccb/logs

StandardOutput=journal
StandardError=journal
SyslogIdentifier=eccb-sockets

[Install]
WantedBy=multi-user.target
